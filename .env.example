# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# AI API Keys (Optional - for enhanced extraction)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (if you want to use GPT models instead)
OPENAI_API_KEY=sk-...

# AusTender API (Optional)
# Register at: https://www.tenders.gov.au/
AUSTENDER_API_KEY=your_api_key

# ABN Lookup Web Services (Optional)
# Register at: https://abr.business.gov.au/Tools/WebServices
ABN_LOOKUP_GUID=your_guid

# Data Source Configuration
MOUNT_ISA_LGA_CODE=LGA35300
MOUNT_ISA_POSTCODE=4825

# Scraping Configuration
SCRAPER_USER_AGENT=Mozilla/5.0 (Queensland Government Data Observatory Bot)
SCRAPER_RATE_LIMIT_SECONDS=2
SCRAPER_TIMEOUT_SECONDS=30

# Development/Production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
