# direnv configuration for Mount Isa Economic Observatory
# This file is committed to git and auto-loads environment variables
# Install direnv: https://direnv.net/

# Load environment variables in priority order:
# 1. .env.local (your local overrides - highest priority)
# 2. .env (your main config)
# 3. .env.example (fallback defaults)

if [ -f .env.local ]; then
  echo "✅ Loading .env.local (local overrides)"
  dotenv .env.local
fi

if [ -f .env ]; then
  echo "✅ Loading .env (main configuration)"
  dotenv .env
else
  echo "⚠️  WARNING: .env not found - copying from .env.example"
  cp .env.example .env
  echo "📝 Please edit .env with your actual credentials"
fi

# Validate required keys are set
required_keys=(
  "ABN_LOOKUP_GUID"
)

for key in "${required_keys[@]}"; do
  if [ -z "${!key}" ]; then
    echo "❌ ERROR: $key is not set in .env"
    echo "   Please add it to your .env file"
  fi
done

# Optional: Load from 1Password if available
# if command -v op &> /dev/null; then
#   export OPENAI_API_KEY=$(op read "op://Private/OpenAI/credential")
#   export SUPABASE_SERVICE_ROLE_KEY=$(op read "op://Private/Supabase/service_role_key")
# fi

echo "🔐 Environment loaded for Mount Isa Economic Observatory"
