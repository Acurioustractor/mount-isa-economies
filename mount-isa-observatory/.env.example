# Mount Isa Economic Observatory Configuration
# Copy this file to .env and fill in your credentials

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mount_isa_observatory
DB_USER=postgres
DB_PASSWORD=your_password_here

# ABN Lookup API
# Register for GUID at: https://abr.business.gov.au/Tools/WebServices
ABN_LOOKUP_GUID=your_guid_here

# ASIC API (Optional - for enhanced entity data)
# Request access at: https://asic.gov.au/for-business/registers/
ASIC_API_KEY=your_asic_key_here

# Optional: Email notifications
NOTIFICATION_EMAIL=your_email@example.com
