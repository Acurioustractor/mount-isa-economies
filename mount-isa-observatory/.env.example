# Mount Isa Economic Observatory Configuration
# Copy this file to .env and fill in your credentials

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL/Supabase)
# ============================================================================
# For local PostgreSQL development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mount_isa_observatory
DB_USER=postgres
DB_PASSWORD=your_password_here

# ============================================================================
# SUPABASE CONFIGURATION (Cloud Database & AI)
# ============================================================================
# Used by: scripts/chat_with_data.py (RAG/LLM chat interface)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================================
# OPENAI API (for LLM Chat Interface)
# ============================================================================
# Used by: scripts/chat_with_data.py (GPT-4 for answering questions)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# FIRECRAWL API (Advanced Web Scraping)
# ============================================================================
# Used by: Bypass 403 blocks, scrape JavaScript-heavy sites, handle CAPTCHAs
# Get from: https://firecrawl.dev/ (500 free credits/month on free tier)
# Why: Queensland Gov sites block simple requests - Firecrawl bypasses this
# Pricing: Free tier 500 credits, then $0.50/1000 credits
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ============================================================================
# ABN LOOKUP API (Australian Business Number)
# ============================================================================
# Used by: scrapers/abn_lookup_professional.py, lookup_mount_isa_suppliers.py
# Register FREE at: https://abr.business.gov.au/Tools/WebServices
ABN_LOOKUP_GUID=your_guid_here

# ============================================================================
# ASIC API (Optional - Australian Securities & Investments Commission)
# ============================================================================
# Used by: Enhanced entity data lookups
# Request access at: https://asic.gov.au/for-business/registers/
ASIC_API_KEY=your_asic_key_here

# ============================================================================
# NOTIFICATIONS (Optional)
# ============================================================================
NOTIFICATION_EMAIL=your_email@example.com

# ============================================================================
# NOTES
# ============================================================================
# Required for basic scraping:
#   - ABN_LOOKUP_GUID (register at link above)
#
# Required for chat/AI features (scripts/chat_with_data.py):
#   - SUPABASE_URL
#   - SUPABASE_SERVICE_ROLE_KEY
#   - OPENAI_API_KEY
#
# Recommended for robust scraping (bypasses 403 blocks):
#   - FIRECRAWL_API_KEY (500 free credits/month)
#
# Optional for local database:
#   - DB_* variables (if not using Supabase)
#
# Optional enhancements:
#   - ASIC_API_KEY (for company data)
#   - NOTIFICATION_EMAIL (for alerts)
